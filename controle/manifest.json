{
  "schemaVersion": 1,
  "id": "esegnorelli.controle",
  "name": "Controle",
  "version": "1.0.0",
  "author": "Evandro Segnorelli",
  "license": "MIT",
  "description": "Control Center for Omarchy: stay awake, DND, night light, capture and focus from glanceable tiles.",
  "kinds": ["bar-widget", "overlay"],
  "entryPoints": {
    "barWidget": "BarWidget.qml",
    "overlay": "Overlay.qml"
  },
  "barWidget": {
    "displayName": "Controle",
    "description": "One-tap Omarchy toggles. State lives on the chip.",
    "category": "System",
    "aliases": ["controle", "focus", "dnd", "cafe", "nightlight", "control center"],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": { "focusMinutes": 25 },
    "schema": [
      {
        "key": "focusMinutes",
        "type": "integer",
        "label": "Focus session minutes",
        "min": 5,
        "max": 120,
        "step": 5,
        "defaultValue": 25
      }
    ]
  }
}
